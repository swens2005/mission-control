# Local development settings. Copy to .env and fill in the blanks:
#   cp .env.example .env && php artisan key:generate
# Production does NOT use a hand-edited .env: see .env.production.example.

APP_NAME="Mission Control"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local MariaDB (production runs MariaDB 11.4). Create the database with:
#   CREATE DATABASE mission_control CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mission_control
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Shared hosting has no long-running queue worker, so jobs run synchronously.
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Shared secret for the post-deploy migration endpoint (see
# docs/decisions/0003-migrations-without-ssh.md). Leave empty locally:
# an empty token disables the endpoint.
DEPLOY_TOKEN=

VITE_APP_NAME="${APP_NAME}"
