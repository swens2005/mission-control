# Template for the PRODUCTION environment. Never fill this file in.
#
# The real values live in ONE GitHub Actions secret, ENV_MISSION_CONTROL_PROD,
# whose value is this whole file with the blanks filled in. The deploy job
# writes that secret to .env in the app folder on the server (outside the web
# root), so no one edits .env by hand on the server and it is never committed.
# See docs/decisions/0002-hosting-layout.md.

APP_NAME="Mission Control"
APP_ENV=production
# Generate once locally with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://codelaunch.nl/mission-control
ASSET_URL=https://codelaunch.nl/mission-control

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# cPanel prefixes database and user names with the account name, e.g. codefhdb_
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Scope the session cookie to the app so it never reaches the portfolio site.
SESSION_PATH=/mission-control
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@codelaunch.nl"
MAIL_FROM_NAME="${APP_NAME}"

# Long random string, e.g.: php -r "echo bin2hex(random_bytes(32));"
# The same value goes in the DEPLOY_TOKEN GitHub secret.
DEPLOY_TOKEN=

VITE_APP_NAME="${APP_NAME}"
